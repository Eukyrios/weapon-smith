{
  "name": "weapon-smith",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Delta Force: Operations attachment data, and the pages generated from it.",
  "scripts": {
    "dev": "vite",
    "gen": "vite-node tools/dump-data.ts && python tools/gen-weapon-smith.py",
